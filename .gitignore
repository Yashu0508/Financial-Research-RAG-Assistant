# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Python environments and caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors and operating systems
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs and temporary artifacts
*.log
logs/
tmp/
temp/
*.tmp

# Local databases and generated indexes
*.db
*.sqlite
*.sqlite3
data/indexes/**
!data/indexes/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/evaluation/**
!data/evaluation/.gitkeep
!data/evaluation/keyword_retrieval.v1.json
!data/evaluation/keyword_retrieval.v2.json
!data/evaluation/table_retrieval_judgments.v1.json
reports/**
!reports/.gitkeep

# Raw filings stay local by default. Reproducibility will use a tracked manifest
# with source URLs and hashes; directory sentinels remain tracked.
data/raw/sec_filings/**
!data/raw/sec_filings/Microsoft/
!data/raw/sec_filings/Microsoft/.gitkeep
!data/raw/sec_filings/Apple/
!data/raw/sec_filings/Apple/.gitkeep
