# Optional local settings. Copy to .env; never commit real credentials.
# The persistent development corpus must use a dedicated non-test database and
# a non-public schema. financial_rag_test is reserved for disposable tests.
APP_ENV=development
DATABASE_URL=
DEVELOPMENT_DATABASE_NAME=financial_rag_dev
DEVELOPMENT_DATABASE_ROLE=financial_rag_dev
DEVELOPMENT_DATABASE_SCHEMA=financial_rag_dev
# Phase 8 uses the explicitly selected OpenAI Responses adapter. Leave these
# blank unless generation is intentionally configured; never commit a real key.
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-6-astra
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=800
EMBEDDING_MODEL=
SEMANTIC_MODEL_CACHE_DIR=
SEMANTIC_EMBEDDING_BATCH_SIZE=16
RERANKER_MODEL=
